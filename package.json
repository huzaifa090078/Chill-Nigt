{
  "name": "chill-night-food-point",
  "version": "1.0.0",
  "description": "Chill Night Food Point — Responsive Fast-Food Order Management & Live Customer Tracking Web Application",
  "private": true,
  "scripts": {
    "postinstall": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/src/server.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "test": "npm test --prefix server"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "keywords": [
    "pos",
    "restaurant-management",
    "fast-food",
    "react",
    "express",
    "sqlite",
    "typescript"
  ],
  "author": "Chill Night Food Point",
  "license": "ISC"
}
